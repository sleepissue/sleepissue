<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="AwakeDrive 개발 검증"
        tools:replace="android:label">
        <activity
            android:name="com.sleepissue.awakedrive.debug.DebugSdkProbeActivity"
            android:exported="false"
            android:theme="@style/Theme.AwakeDrive.DebugHarness" />
        <activity
            android:name="com.sleepissue.awakedrive.debug.DebugHubProbeActivity"
            android:exported="false"
            android:theme="@style/Theme.AwakeDrive.DebugHarness" />
        <activity
            android:name="com.sleepissue.awakedrive.debug.DebugHarnessActivity"
            android:exported="true"
            android:label="AwakeDrive 개발 검증"
            android:theme="@style/Theme.AwakeDrive.DebugHarness"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
