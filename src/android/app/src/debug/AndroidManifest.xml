<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="AwakeDrive 개발 검증"
        tools:replace="android:label">

        <!-- 기존: Pleos SDK 검증 화면 -->
        <activity
            android:name="com.sleepissue.awakedrive.debug.DebugSdkProbeActivity"
            android:exported="false"
            android:theme="@style/Theme.AwakeDrive.DebugHarness" />

        <!-- 기존: 차량 데이터 검증 화면 -->
        <activity
            android:name="com.sleepissue.awakedrive.debug.DebugHubProbeActivity"
            android:exported="false"
            android:theme="@style/Theme.AwakeDrive.DebugHarness" />

        <!-- 기존: 통합 기능 검증 화면 -->
        <activity
            android:name="com.sleepissue.awakedrive.debug.DebugHarnessActivity"
            android:exported="true"
            android:label="AwakeDrive 개발 검증"
            android:theme="@style/Theme.AwakeDrive.DebugHarness"
            android:windowSoftInputMode="adjustResize">


        </activity>

        <!-- 기존: 3번 담당 음성·실내 검증 화면 -->
        <activity
            android:name="com.sleepissue.awakedrive.voice.VoiceValidationActivity"
            android:exported="true"
            android:label="음성 기능 검증">

        </activity>

        <!-- 신규: 5번 담당 주행 화면 UI 테스트 -->
        <activity
            android:name="com.sleepissue.awakedrive.ui.DrivingPreviewActivity"
            android:exported="true"
            android:label="AwakeDrive 주행 화면">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>